{
  "name": "@friendly/mautic-content-block-bundle-assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild \"Assets/js/src/*.ts\" --bundle --format=iife --target=es2022 --outdir=Assets/js/dist --minify",
    "build:dev": "esbuild \"Assets/js/src/*.ts\" --bundle --format=iife --target=es2022 --outdir=Assets/js/dist --sourcemap=inline",
    "watch": "npm run build:dev -- --watch",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mjml-browser": "4.18.0",
    "typescript": "^5.7.0"
  }
}
