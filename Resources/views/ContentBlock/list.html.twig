{%- set isIndex = 'index' == tmpl -%}
{%- set tmpl = 'list' -%}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent 'contentBlock' %}

{% block headerTitle 'mautic.contentblock.menu.index'|trans %}

{% block actions %}
    {{- include('@MauticCore/Helper/page_actions.html.twig', {
        'templateButtons': {
            'new': securityIsGranted('contentBlock:blocks:create'),
        },
        'routeBase': 'contentblock',
        'langVar':   'mautic.contentblock',
    }) -}}
{% endblock %}

{% block content %}
    {% if isIndex %}
        <div id="page-list-wrapper" class="{% if items|length > 0 or searchValue is not empty %}panel {% endif %}panel-default">
            {{ include('@MauticCore/Helper/list_toolbar.html.twig', {
                'searchValue': searchValue,
                'action': currentRoute,
            }) }}
            <div class="page-list">
                {{- include('@MauticContentBlock/ContentBlock/_list.html.twig') -}}
            </div>
        </div>
    {% else %}
        {{- include('@MauticContentBlock/ContentBlock/_list.html.twig') -}}
    {% endif %}
{% endblock %}
