{% if items|length > 0 %}
    <div class="table-responsive">
        <table class="table table-hover cb-list">
            <thead>
                <tr>
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'checkall':        'true',
                        'routeBase':       'contentblock',
                        'templateButtons': {'delete': securityIsGranted('contentBlock:blocks:delete')},
                    }) -}}
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'contentBlock',
                        'orderBy':    'name',
                        'text':       'mautic.core.name',
                        'class':      'col-cb-name',
                        'default':    true,
                    }) -}}
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'contentBlock',
                        'orderBy':    'cat.title',
                        'text':       'mautic.core.category',
                        'class':      'visible-md visible-lg col-cb-category',
                    }) -}}
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'contentBlock',
                        'orderBy':    'date_added',
                        'text':       'mautic.core.date.added',
                        'class':      'visible-md visible-lg col-cb-date',
                    }) -}}
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'contentBlock',
                        'orderBy':    'id',
                        'text':       'mautic.core.id',
                        'class':      'visible-md visible-lg col-cb-id',
                    }) -}}
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr id="cb-row-{{ item.id }}" data-id="{{ item.id }}">
                        <td>
                            {{- include('@MauticCore/Helper/list_actions.html.twig', {
                                'item':            item,
                                'templateButtons': {
                                    'edit':   securityIsGranted('contentBlock:blocks:edit'),
                                    'delete': securityIsGranted('contentBlock:blocks:delete'),
                                },
                                'routeBase':       'contentblock',
                                'translationBase': 'mautic.contentblock',
                            }) -}}
                        </td>
                        <td>
                            <div>
                                {{- include('@MauticCore/Helper/publishstatus_icon.html.twig', {
                                    'item':   item,
                                    'model':  'content_block',
                                    'status': item.published ? 'published' : 'unpublished',
                                }) -}}
                                <span class="cb-icon-cell"
                                      data-emoji="{{ (item.icon ?? '')|e('html_attr') }}"
                                      style="display:inline-block;width:20px;height:20px;vertical-align:middle;margin:0 4px 0 2px;"></span>
                                <a href="{{ path('mautic_contentblock_action', {objectAction: 'edit', objectId: item.id}) }}"
                                   data-toggle="ajax">{{ item.name|e }}</a>
                            </div>
                        </td>
                        <td class="visible-md visible-lg">
                            {%- set category = item.category -%}
                            {%- set catName  = category ? category.title : 'mautic.core.form.uncategorized'|trans -%}
                            {%- set color    = category and category.color ? '#' ~ category.color : '' -%}
                            <div class="d-flex ai-center gap-xs">
                                <span class="label label-gray label-category" style="background: {{ color }};"> </span> {{ catName|e }}
                            </div>
                        </td>
                        <td class="visible-md visible-lg text-muted">{{ item.dateAdded ? item.dateAdded|date('Y-m-d H:i:s') : '' }}</td>
                        <td class="visible-md visible-lg text-muted">{{ item.id }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="panel-footer">
        {{- include('@MauticCore/Helper/pagination.html.twig', {
            'totalItems': totalItems,
            'page':       page,
            'limit':      limit,
            'menuLinkId': 'mautic_contentblock_index',
            'baseUrl':    currentRoute,
            'sessionVar': 'contentBlock',
        }) -}}
    </div>
{% else %}
    {% if searchValue is not empty %}
        {{- include('@MauticCore/Helper/noresults.html.twig') -}}
    {% else %}
        <div class="mt-80 col-md-offset-2 col-lg-offset-3 col-md-8 col-lg-5 height-auto">
            {% set childContainer %}
                <div class="mt-32 mb-md">
                    <i class="ri-layout-grid-line" style="font-size:80px;color:#ccc;"></i>
                </div>
            {% endset %}
            {{ include('@MauticContentBlock/Components/content-block.html.twig', {
                heading: 'mautic.contentblock.empty.heading',
                subheading: 'mautic.contentblock.empty.subheading',
                copy: 'mautic.contentblock.empty.copy',
                childContainer: childContainer,
                cta: securityIsGranted('contentBlock:blocks:create') ? {
                    'label': 'mautic.contentblock.new',
                    'link': path('mautic_contentblock_action', {objectAction: 'new'}),
                    'attributes': {'data-toggle': 'ajax'}
                } : null
            }) }}
        </div>
    {% endif %}
{% endif %}
