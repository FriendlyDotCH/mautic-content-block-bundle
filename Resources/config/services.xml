<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="MauticPlugin\MauticContentBlockBundle\Model\ContentBlockModel"
                 parent="mautic.model.base"
                 public="true" />

        <service id="MauticPlugin\MauticContentBlockBundle\Controller\ContentBlockApiController"
                 public="true"
                 autoconfigure="true">
            <argument type="service" id="doctrine.dbal.default_connection" />
        </service>

        <service id="MauticPlugin\MauticContentBlockBundle\Controller\ContentBlockController"
                 public="true"
                 autoconfigure="true">
            <argument type="service" id="doctrine.dbal.default_connection" />
            <argument type="service" id="twig" />
        </service>

        <service id="MauticPlugin\MauticContentBlockBundle\EventListener\BuilderAssetSubscriber"
                 public="false">
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="MauticPlugin\MauticContentBlockBundle\EventListener\CsrfExcludeSubscriber"
                 public="false">
            <tag name="kernel.event_subscriber" />
        </service>

    </services>

</container>
