{# @MauticContentBlock/ContentBlock/form.html.twig #}
{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}contentBlock{% endblock %}

{% block headerTitle %}
    {% if entity.id %}
        {{ 'mautic.contentblock.form.edit'|trans({'%name%': entity.name}) }}
    {% else %}
        {{ 'mautic.contentblock.form.new'|trans }}
    {% endif %}
{% endblock %}

{% block content %}
{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

<div class="panel panel-default">
    <div class="panel-body">

        <div class="form-group">
            {{ form_label(form.name) }}
            <div class="col-sm-10">{{ form_widget(form.name) }}</div>
        </div>

        <div class="form-group">
            {{ form_label(form.category) }}
            <div class="col-sm-10">{{ form_widget(form.category) }}</div>
        </div>

        <div class="form-group">
            {{ form_label(form.htmlContent) }}
            <div class="col-sm-12">
                {#
                  Render textarea; CodeMirror is automatically activated by Mautic
                  when data-codemirror="html" is present on the element.
                #}
                {{ form_widget(form.htmlContent) }}
            </div>
        </div>

    </div>{# /panel-body #}

    <div class="panel-footer">
        <button type="submit" class="btn btn-primary">
            <i class="ri-save-line"></i>
            {{ 'mautic.core.form.save'|trans }}
        </button>
        <a href="{{ path('mautic_contentblock_index') }}" class="btn btn-default">
            {{ 'mautic.core.form.cancel'|trans }}
        </a>
    </div>
</div>

{{ form_end(form) }}
{% endblock %}
