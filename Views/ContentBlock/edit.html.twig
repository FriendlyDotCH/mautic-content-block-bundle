{% extends '@MauticCore/Default/content.html.twig' %}

{% block headerTitle %}{% trans %}mautic.contentblock.edit{% endtrans %}: {{ item.name|e }}{% endblock %}
{% block mauticContent %}contentBlockEdit{% endblock %}

{% block actions %}
    <a href="{{ path('mautic_contentblock_index') }}" class="btn btn-default btn-lg" data-toggle="ajax">
        <i class="ri-arrow-left-line"></i> {% trans %}mautic.core.form.cancel{% endtrans %}
    </a>
{% endblock %}

{% block content %}
<div class="panel panel-default">
    <div class="panel-body">

        {% if error is not null %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        <form name="contentBlockEdit"
              data-toggle="ajax"
              method="post"
              action="{{ path('mautic_contentblock_edit_page', {objectId: item.id}) }}">

            <div class="row">
                <div class="col-sm-8">
                    <div class="form-group">
                        <label>{% trans %}mautic.core.name{% endtrans %} <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control"
                               value="{{ item.name|e }}" maxlength="191" required>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label>{% trans %}mautic.core.category{% endtrans %}</label>
                        <input type="text" name="category" class="form-control"
                               value="{{ (item.category ?? 'general')|e }}"
                               placeholder="general">
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>{% trans %}mautic.contentblock.icon{% endtrans %} <small class="text-muted">({% trans %}mautic.core.optional{% endtrans %})</small></label>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                    <span id="cb-edit-icon-preview" style="min-width:32px;min-height:28px;display:inline-block;"></span>
                    <span id="cb-edit-icon-label" style="font-size:12px;color:#999;"></span>
                </div>
                <div id="cb-edit-emoji-grid"
                     style="background:#f8f8f8;border:1px solid #ddd;border-radius:6px;padding:10px;max-height:140px;overflow-y:auto;line-height:1.6;"></div>
                <input type="hidden" name="icon" id="cb-edit-icon" value="{{ (item.icon ?? '')|e('html_attr') }}">
            </div>

            <div class="form-group">
                <label>{% trans %}mautic.contentblock.html_content{% endtrans %} <span class="text-danger">*</span></label>
                <textarea name="htmlContent" class="form-control" rows="22"
                          style="font-family:'Courier New',monospace;font-size:12px;line-height:1.5;resize:vertical;">{{ item.html_content|e }}</textarea>
            </div>

            <div class="well well-sm" style="margin-top:16px;">
                <button type="submit" id="cb-edit-save" name="cb-edit-save" class="btn btn-primary btn-save">
                    <i class="ri-save-line"></i> {% trans %}mautic.core.form.save{% endtrans %}
                </button>
                <a href="{{ path('mautic_contentblock_index') }}" class="btn btn-default" data-toggle="ajax" style="margin-left:8px;">
                    {% trans %}mautic.core.form.cancel{% endtrans %}
                </a>
            </div>

        </form>
    </div>
</div>
{% endblock %}
