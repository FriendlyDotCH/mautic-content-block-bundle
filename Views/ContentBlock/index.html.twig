{% set isIndex = tmpl == 'index' ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}
{% block mauticContent %}contentBlock{% endblock %}
{% block headerTitle %}{% trans %}mautic.contentblock.menu.index{% endtrans %}{% endblock %}

{% block actions %}
    <a class="btn btn-primary btn-lg"
       href="{{ path('mautic_contentblock_new') }}"
       data-toggle="ajax">
        <i class="ri-add-line"></i> {% trans %}mautic.core.form.new{% endtrans %}
    </a>
{% endblock %}

{% block content %}
    {% if isIndex %}
    <div id="page-list-wrapper" class="{% if items|length > 0 or searchValue is not empty %}panel {% endif %}panel-default">
        {{- include('@MauticCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue,
            'action':      currentRoute,
        }) -}}
        <div class="page-list">
            {{ block('listResults') }}
        </div>
    </div>
    {% else %}
        {{ block('listResults') }}
    {% endif %}
{% endblock %}

{% block listResults %}
{% if items|length > 0 %}
    <div class="table-responsive">
        <table class="table table-hover cb-list">
            <thead>
                <tr>
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'checkall':        'true',
                        'routeBase':       'contentblock',
                        'templateButtons': {'delete': true},
                    }) -}}
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'contentBlock',
                        'orderBy':    'name',
                        'text':       'mautic.core.name',
                        'class':      'col-cb-name',
                        'default':    true,
                    }) -}}
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'contentBlock',
                        'orderBy':    'category',
                        'text':       'mautic.core.category',
                        'class':      'visible-md visible-lg col-cb-category',
                    }) -}}
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'contentBlock',
                        'orderBy':    'date_added',
                        'text':       'mautic.core.date.added',
                        'class':      'visible-md visible-lg col-cb-date',
                    }) -}}
                    {{- include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'contentBlock',
                        'orderBy':    'id',
                        'text':       'mautic.core.id',
                        'class':      'visible-md visible-lg col-cb-id',
                    }) -}}
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    {% set pub = item.is_published %}
                    <tr id="cb-row-{{ item.id }}" data-id="{{ item.id }}">
                        <td>
                            {{- include('@MauticCore/Helper/list_actions.html.twig', {
                                'item':            item,
                                'templateButtons': {'edit': true, 'delete': true},
                                'routeBase':       'contentblock',
                                'translationBase': 'mautic.contentblock',
                            }) -}}
                        </td>
                        <td>
                            {{- include('@MauticCore/Helper/publishstatus_icon.html.twig', {
                                'item':  item|merge({'publishStatus': pub ? 'published' : 'unpublished'}),
                                'model': 'content_block',
                            }) -}}
                            <span class="cb-icon-cell"
                                  data-emoji="{{ (item.icon ?? '')|e('html_attr') }}"
                                  style="display:inline-block;width:20px;height:20px;vertical-align:middle;margin:0 4px 0 2px;"></span>
                            <a href="{{ path('mautic_contentblock_action', {objectAction: 'edit', objectId: item.id}) }}"
                               data-toggle="ajax">{{ item.name|e }}</a>
                        </td>
                        <td class="visible-md visible-lg">{{ (item.category ?? 'general')|e }}</td>
                        <td class="visible-md visible-lg text-muted">{{ item.date_added ?? '' }}</td>
                        <td class="visible-md visible-lg text-muted">{{ item.id }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="panel-footer">
        {{- include('@MauticCore/Helper/pagination.html.twig', {
            'totalItems': totalItems,
            'page':       page,
            'limit':      limit,
            'menuLinkId': 'mautic_contentblock_index',
            'baseUrl':    currentRoute,
            'sessionVar': 'contentBlock',
        }) -}}
    </div>
{% else %}
    {% if searchValue is not empty %}
        {{- include('@MauticCore/Helper/noresults.html.twig') -}}
    {% else %}
        <div class="text-center pa-md text-muted">
            {% trans %}mautic.contentblock.no_items{% endtrans %}
        </div>
    {% endif %}
{% endif %}
{% endblock %}
